# Server
PORT=4000
NODE_ENV=development
JWT_SECRET=change_me_to_a_long_random_string

# Postgres
DATABASE_URL=postgres://hustle:hustle_dev_password@localhost:5432/hustle_through

# Redis
REDIS_URL=redis://localhost:6379

# Apple App Store receipt verification
APPLE_SHARED_SECRET=your_app_specific_shared_secret
APPLE_VERIFY_URL_PROD=https://buy.itunes.apple.com/verifyReceipt
APPLE_VERIFY_URL_SANDBOX=https://sandbox.itunes.apple.com/verifyReceipt

# Google Play receipt verification
GOOGLE_PLAY_PACKAGE_NAME=com.yourstudio.hustlethrough
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=./secrets/google-service-account.json
